{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hesab",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "hesab-db", "database_id": "cbacd937-b2b5-4ae2-99d8-56582f23e443" }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/sms"]
  }
}
